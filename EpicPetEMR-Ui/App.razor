@using Microsoft.AspNetCore.Components.Routing
@using EpicPetEMR_Ui.Services
@inject TokenStore Tokens
@inject NavigationManager Nav

<Router AppAssembly="@typeof(App).Assembly">
    <Found Context="routeData">
        <RouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
        
        </RouteView>
        <FocusOnNavigate RouteData="@routeData" Selector="h1" />
    </Found>
    <NotFound>
        <PageTitle>Not found</PageTitle>
        <LayoutView Layout="@typeof(MainLayout)">
            <p role="alert">Sorry, there's nothing at this address.</p>
        </LayoutView>
    </NotFound>
</Router>

@code
{protected override async Task
    
    OnInitializedAsync()
    {
        var token = await Tokens.GetTokenAsync();
        var currentUrl = Nav.Uri;
        var isOnPublicPage = currentUrl.Contains("/login") || currentUrl.Contains("/register");

            if(string.IsNullOrWhiteSpace(token) && !isOnPublicPage) 
            {
                Nav.NavigateTo("/login");
            }
    }
}
