@page "/pets"
@using EpicPetEMR_Ui.Services
@using EpicPetEMR.Shared.Models   
@using Microsoft.AspNetCore.Components.Forms
@inject PetApi Api

@if (isPageDataLoading)
{
    <p>Loading pets…</p>
}

else
{
    if (petCurrentlyBeingEdited is not null)
    {
        <!-- When editing, wrap the entire table in a single EditForm so inputs are valid and submit works -->
        

        <EditForm Model="@petDraftBeingEdited" OnValidSubmit="@SaveChangesAsync">
            <DataAnnotationsValidator />
            <ValidationSummary />
            <table class="table">
                <thead>
                    <tr>
                        <th>Pet test  </th>
                        <th>Species</th>
                        <th>Breed</th>
                        <th>Sex</th>
                        <th>Weight</th>
                         <th></th>
                        <th>Birthday</th>
                        
                        <th style="width:180px;"></th>
                    </tr>
                </thead>
                <tbody>
              @foreach (var currentPet in petsLoadedFromApi)
{
    if (object.ReferenceEquals(currentPet, petCurrentlyBeingEdited))
    {
        <!-- Edit row -->
        <tr>
            <td>
                <InputText class="form-control" @bind-Value="petDraftBeingEdited.Name" />
            </td>

            <td>
                <InputText class="form-control" @bind-Value="petDraftBeingEdited.Species" />
            </td>

            <td>
                <InputText class="form-control" @bind-Value="petDraftBeingEdited.Breed" />
            </td>

            <td>
                <InputText class="form-control" @bind-Value="petDraftBeingEdited.Sex" />
            </td>

            <td>
                <InputNumber style="width:120px;" class="form-control" @bind-Value="petDraftBeingEdited.Weight" />
            </td>

            <td>
                <div class="input-group">
         <InputSelect @bind-Value="petDraftBeingEdited.WeightUnit" TValue="string"
             class="form-select unit-select" style="width:75px;">
    <option value="kg">kg</option>
    <option value="lbs">lbs</option>
</InputSelect>

                </div>
            </td>

            <td>
                <InputDate DateFormat="MM/dd/yyyy"
                           class="form-control"
                           @bind-Value="petDraftBeingEdited.DateOfBirth" />
            </td>

            <td>
                @petDraftBeingEdited.Family?.Name
            </td>

            <td style="
                height: 55px;
                position: relative;
                display: flex;
                left: -63px;
                width: 234px;
                justify-content: center;
                align-items: center;
                gap: 0px;
            ">
                <button type="submit" class="btn btn-success btn-sm me-2">Save</button>

                <button type="button" class="btn btn-secondary btn-sm" @onclick="CancelEdit">
                    Cancel
                </button>

                <button type="button"
                        class="btn btn-outline-danger btn-sm"
                        style="position: relative; right: -9px;"
                        @onclick="() => ConfirmDeletePet(currentPet)">
                    Delete Pet
                </button>
            </td>
        </tr>
                            @if (deleteconfirm)
                            {
                                <div class="modal-overlay">
        <div class="modal-box">
            <h4>Delete @PetToDelete?.Name?</h4>
            <p>Are you sure you want to delete this pet?</p>

            <div class="modal-buttons">
                <button class="btn btn-danger" @onclick="async () => await DeletePet(PetToDelete!)">Delete</button>
                <button class="btn btn-secondary"  @onclick="() => deleteconfirm = false">Cancel</button>
            </div>
        </div>
    </div>
                            }
    } 
    else
    {
        <!-- View row -->
        <tr>
            <td>
                <a href="petprofile/@currentPet.Id">@currentPet.Name</a>
            </td>

            <td>@currentPet.Species</td>
            <td>@currentPet.Breed</td>
            <td>@currentPet.Sex</td>

            <td>
                @(currentPet.Weight is null 
                    ? "-" 
                    : $"{currentPet.Weight} {currentPet.WeightUnit}")
            </td>

            <td>@(currentPet.DateOfBirth?.ToString("MM/dd/yyyy") ?? "")</td>

            <td>@currentPet.Family?.Name</td>

            <td>
                <button class="btn btn-primary btn-sm"
                        @onclick="() => EnableEdit(currentPet)">
                    Edit
                </button>
            </td>
        </tr>
    }
}

                </tbody>
            </table>
        </EditForm>
    }
    else
    {
        <!-- Not editing anything: render a simple view-only table -->
        <td><button class="btn btn-primary btn-sm" @onclick="() => OpenAddPetForm()">Add Pet</button></td>
        @if (showform)
        {
            <EditForm Model="newPet" OnValidSubmit="AddPet">
                <div class="mb-3">
                    <label>Name:</label>
                    <InputText class="form-control" @bind-Value="newPet.Name" />
                </div>

                 <div class="mb-3">
                    <label>Species:</label>
                    <InputSelect class="form-select" @bind-Value="newPet.Species">
                        <option value="">Select...</option>
                        <option>Dog</option>
                        <option>Cat</option>
                    </InputSelect>
                </div>

                <div class="mb-3">
                    <label>Breed:</label>
                    <InputText class="form-control" @bind-Value="newPet.Breed" />
                </div>

               

                <div class="mb-3">
                
                     <label>Sex:</label>
    <InputSelect class="form-select" @bind-Value="newPet.Sex">

                     @foreach (var value in Enum.GetValues<Sex>())
                    {
                      <option value="@value">@value</option>
                    }
                    </InputSelect>
                </div>

                <div class="mb-3">
                    <label>Birthday</label>
                    <InputDate DateFormat="MM/dd/yyyy" class="form-control" @bind-Value="newPet.DateOfBirth" />
                </div>

                <div class="mb-3">
                    <label>Weight:</label>
                    <InputNumber class="form-control" @bind-Value="newPet.Weight" />
                </div>

                <div class="mb-3">
                    <label>Weight Unit:</label>
                    <InputSelect class="form-select" @bind-Value="newPet.WeightUnit">
                        <option value="">Select...</option>
                        <option value="lbs">lbs</option>
                        <option value="kg">kg</option>
                    </InputSelect>
                </div>

                <button class="btn btn-primary" type="submit">Save Pet</button>
            </EditForm>

            @if (submitted)
            {
                <div class="alert alert-success mt-3">
                    Pet submitted successfully!
                    <h1>@petInfo</h1>
                </div>
            }
        }

        <table class="table">
            <thead>
                <tr>
                    <th>Pet</th>
                    <th>Species</th>
                    <th>Breed</th>
                    <th>Sex</th>
                    <th>Weight</th>
                   
                    <th>DOB</th>
                    
                    <th style="width:180px;"></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var currentPet in petsLoadedFromApi)
            {
                <tr> 
          <td>
@{
    var pic = currentPet.ProfilePic ?? "";

    var photoUrl = pic.StartsWith("http", StringComparison.OrdinalIgnoreCase)
        ? pic                                           
        : $"https://localhost:60174{pic}";             
}

@if (!string.IsNullOrEmpty(currentPet.ProfilePic))
{
    <img src="@photoUrl"
         class="pet-prof-pic"
         style="object-fit:cover;width:50px;height:50px;border:3px solid darkslategray;border-radius:50px;" />
}



    <a href="petprofile/@currentPet.Id">@currentPet.Name</a>
</td>


                    <td>@currentPet.Species</td>
                     <td>@currentPet.Breed</td>
                    <td>@currentPet.Sex</td>
                    <td>@(currentPet.Weight is null ? "-" : $"{currentPet.Weight} {currentPet.WeightUnit}")</td>
                   
                    <td>@(currentPet.DateOfBirth?.ToString("MM/dd/yyyy") ?? "")</td>
                    <td>@currentPet.Family?.Name</td>
                    <td>
                        <button class="btn btn-primary btn-sm" @onclick="() => EnableEdit(currentPet)">Edit</button>
                    </td>
                </tr>
            }
            </tbody>
        </table>
        

    <style>
    .unit-select select {
        width:140px;

    }
    /* click-to-complete visual */
.done {
    box-shadow: inset 0 0 0 2px #2ecc71;
}


/* Make the scroll container define the sticky context */
.board {
    position: relative;        /* ensures sticky works predictably */
    overflow: auto;            /* you already have this */
}

/* Header row stays at top while vertical scrolling */
.header {
    position: sticky;
    top: 0;
    z-index: 6;                /* above the left column so they don't overlap weirdly */
    background: var(--bg-header);
    font-weight: 600;
}

/* Left patient-name column stays visible while horizontal scrolling */
.sticky-left {
    position: sticky;
    left: 0;
    z-index: 5;                /* below header, above normal cells */
    background: var(--bg-sticky);
    font-weight: 600;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;

    /* add a visual separator so it feels like a fixed column */
    box-shadow: 1px 0 0 rgba(0,0,0,0.06);
}

.content {
    max-width:90vw;
    overflow:scroll;
}

/* Top-left corner (fixed for both directions) */
.corner {
    position: sticky;
    top: 0;
    left: 0;
    z-index: 7;                /* above everything */
    background: var(--bg-header);
    font-weight: 700;
}

.modal-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.5); /* dark background */
    display: flex;
    justify-content: center;
    align-items: center;
    z-index: 2000; /* stays above everything */
}

.modal-box {
    background: white;
    padding: 20px;
    width: 320px;
    border-radius: 8px;
    box-shadow: 0 0 10px rgba(0,0,0,0.3);
    animation: fadeIn 0.15s ease-out;
}

.modal-buttons {
    margin-top: 15px;
    display: flex;
    justify-content: flex-end;
    gap: 10px;
}


    </style>
    }
}

@code {
    // ----- State fields with explicit names -----
    private bool isPageDataLoading = true;
    private string? loadErrorMessage;
    private string? petInfo;
    private string weightUnit = "kg";

    private List<PetDto> petsLoadedFromApi = new();
    private PetDto newPet = new();
    private bool submitted = false;
    private bool deleteconfirm = false;
    private PetDto PetToDelete;

    private void HandleValidSubmit()
    {
        // For now, just simulate saving.
        // Later, we’ll send it to an API or database.
        Console.WriteLine($"New Pet Added: {newPet.Name}, {newPet.Species}");
        petInfo = newPet.Name;
        submitted = true;
    }
    // The pet row currentl  in "edit mode" (reference to the original item in the list)
    private PetDto? petCurrentlyBeingEdited;

    // A separate, editable draft copy of the pet. We only copy it back on Save.
    private PetDto petDraftBeingEdited = new();

    // ----- Lifecycle -----
    protected override async Task OnInitializedAsync()
    {
        try
        {
            petsLoadedFromApi = await Api.GetPetsAsync();
        }
        catch (Exception ex)
        {
            loadErrorMessage = ex.Message;
        }
        finally
        {
            isPageDataLoading = false;
        }
    }

    // ----- Commands -----
    private void EnableEdit(PetDto petToEdit)
    {
        petCurrentlyBeingEdited = petToEdit;
        petDraftBeingEdited = CreateDeepCopyOfPet(petToEdit); // work on a copy so Cancel discards changes
        if (!string.IsNullOrWhiteSpace(petDraftBeingEdited.WeightUnit))
            petDraftBeingEdited.WeightUnit = petDraftBeingEdited.WeightUnit.Trim().ToLower();
    }
    private async Task LoadPetsAsync()
    {
        isPageDataLoading = true;

        petsLoadedFromApi = await Api.GetPetsAsync();

        isPageDataLoading = false;
    }

    private async Task ReloadPetsAsync()
    {
        await LoadPetsAsync();
    }
    private void CancelEdit()
    {
        // Throw away the draft and exit edit mode
        petCurrentlyBeingEdited = null;
        petDraftBeingEdited = new();
        StateHasChanged();
    }

    private void ConfirmDeletePet(PetDto pet)
    {
       
        PetToDelete = pet;
        deleteconfirm = true;
    }

    private async Task DeletePet(PetDto pet)
    {
        
         deleteconfirm = false;

        await Api.DeletePet(pet);
        
        StateHasChanged();
        petCurrentlyBeingEdited = null;
        
        await ReloadPetsAsync();
    }


    private async Task SaveChangesAsync()
    {
        // Save changes to the API, then copy draft values back into the original list item
        if (petCurrentlyBeingEdited is null)
            return;

        await Api.UpdatePetAsync(petDraftBeingEdited);

        CopyPetValuesIntoExistingInstance(source: petDraftBeingEdited, destination: petCurrentlyBeingEdited);

        // Exit edit mode
        petCurrentlyBeingEdited = null;
        petDraftBeingEdited = new();
        StateHasChanged();
        await ReloadPetsAsync();
    }

    private async Task AddPet()
    {

        await Api.AddPetAsync(newPet);

        // Exit edit mode

        StateHasChanged();
        showform = !showform;
        await ReloadPetsAsync();
    }
    private bool showform = false;

    private void OpenAddPetForm()
    {
        showform = !showform;
    }
    // ----- Helpers (copy/clone) -----
    private static PetDto CreateDeepCopyOfPet(PetDto source) => new PetDto
    {
        Id = source.Id,
        Name = source.Name,
        ProfilePic = source.ProfilePic,
        Breed = source.Breed,
        Species = source.Species,
        Sex = source.Sex,
        Weight = source.Weight,
           WeightUnit = source.WeightUnit?.Trim().ToLower(),
        DateOfBirth = source.DateOfBirth,
        // If Family should be editable, consider cloning it as well. For now, keep reference.
        Family = source.Family
    };

    private static void CopyPetValuesIntoExistingInstance(PetDto source, PetDto destination)
    {
        destination.Name = source.Name;
        destination.ProfilePic = source.ProfilePic;
        destination.Breed = source.Breed;
        destination.Species = source.Species;
        destination.Sex = source.Sex;
        destination.Weight = source.Weight;
        destination.WeightUnit = source.WeightUnit;
        destination.DateOfBirth = source.DateOfBirth;
        destination.Family = source.Family;
    }
}
