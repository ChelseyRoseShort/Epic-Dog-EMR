@page "/mar/task/{petId:int}/{hour:int}"
@using EpicPetEMR_Ui.Services
@using EpicPetEMR.Shared.Models
@using Microsoft.AspNetCore.Components.Forms
@using EpicPetEMR_Ui.Modals
@inject PetApi Api

@if (isLoading)
{
    <p>Loading pet data...</p>
}
else if (pet == null)
{
    <p>Pet not found.</p>
    <button @onclick="ReloadPet" class="btn btn-success">Reload1Pet</button>
}
else
{
    
<h3>Medication Administration Record </h3>
<h2>@pet.Name</h2>
    @foreach (var med in meds)
    {
        <input type="checkbox"
               class="mar-checkbox"
               @onclick="() => MarkGiven(pet.Id, med.Id, hour)" />
        <h2>@med.Name, @($"{med.DoseValue:0.##}") @med.DoseType @med.Route @med.Frequency</h2>
        <h2>@med.LastGiven</h2> <h2>Due at: @med.StartTime</h2>
    }
   
}


@code {
    [Parameter] public int PetId { get; set; }
    [Parameter] public int hour { get; set; }

    private PetDto? pet;
    private List<MedicationDto> meds = new List<MedicationDto>();
    private bool isLoading = true;
private int GetScheduledHour(MedicationDto med)
{
    if (med.StartTime is null)
        return 0;

    return med.StartTime.Value.Hour;
}

    protected override async Task OnInitializedAsync()
    {
        try
        {
            pet = await Api.GetPetById(PetId);
            meds = await Api.GetMedsById(PetId);
            meds = meds
            .OrderBy(m => Math.Abs(GetScheduledHour(m) - hour))
            .ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error fetching pet data: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task ReloadPet()
    {
        try
        {
            pet = await Api.GetPetById(PetId);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error fetching pet: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }
    void MarkGiven(int petId, int medId, int hour)
    {
        Console.WriteLine($"GIVEN → Pet:{petId}, Med:{medId}, Hour:{hour}");
        // save to DB or tracking list later
    }


}
