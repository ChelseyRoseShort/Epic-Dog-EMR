@page "/mar/task/{petId:int}/{hour:int}"
@using EpicPetEMR_Ui.Services
@using EpicPetEMR.Shared.Models
@using Microsoft.AspNetCore.Components.Forms
@using EpicPetEMR_Ui.Modals
@inject PetApi Api
@inject NavigationManager Nav

@if (isLoading)
{
    <div class="mar-state mar-state-loading">
        <div class="mar-spinner"></div>
        <p>Loading pet data...</p>
    </div>
}
else if (pet == null)
{
    <div class="mar-state mar-state-error">
        <h2>Pet not found.</h2>
        <p>We couldn’t load this MAR. Try reloading the pet.</p>
        <button @onclick="ReloadPet" class="epic-pet-button">
            Reload Pet
        </button>
    </div>
}
else
{
    <div class="mar-page-container">
        <header class="mar-header">
            <div>
                <p class="mar-badge">MAR</p>
                <h1 class="mar-title">Medication Administration Record</h1>
                <p class="mar-subtitle">Real-time charting for this hour.</p>
            </div>
            <div class="mar-header-meta">
                <div class="mar-pet-name">@pet.Name</div>
                <div class="mar-hour-chip">@hour:00</div>
            </div>
        </header>

        <section class="mar-summary">
            <div class="mar-summary-item">
                <span class="mar-summary-label">Scheduled Meds</span>
                <span class="mar-summary-value">@meds.Count</span>
            </div>
            <div class="mar-summary-item">
                <span class="mar-summary-label">PRN Meds</span>
                <span class="mar-summary-value">@prnmeds.Count</span>
            </div>
            <div class="mar-summary-item">
                <span class="mar-summary-label">Selected</span>
                <span class="mar-summary-value">@_selectedMeds.Count</span>
            </div>
        </section>

        <div class="mar-layout">
            <!-- Scheduled meds -->
            <section class="mar-column">
                <div class="mar-section-header">
                    <h2>Scheduled Medications</h2>
                    <p>Medications due around @hour:00.</p>
                </div>

                @if (meds == null || !meds.Any())
                {
                    <p class="mar-empty">
                        No scheduled medications due at @hour:00 (all charted 🎉).
                    </p>
                }
                else
                {
                    @foreach (var med in meds)
                    {
                        <article class="mar-med-card">
                            <label class="mar-med-checkbox">
                                <input type="checkbox"
                                       class="mar-checkbox"
                                       @onchange="e => ToggleSelected(pet.Id, med.Id, hour, e)" />
                                <span class="mar-checkbox-custom"></span>
                            </label>

                            <div class="mar-med-content">
                                <h3 class="mar-med-name">
                                    @med.Name
                                </h3>
                                <p class="mar-med-details">
                                    @($"{med.DoseValue:0.##}") @med.DoseType &bull;
                                    @med.Route &bull;
                                    @med.Frequency
                                </p>

                                <div class="mar-med-meta">
                                    <span class="mar-chip mar-chip-primary">
                                        Due at @med.StartTime
                                    </span>
                                    @if (med.LastGiven != null)
                                    {
                                        <span class="mar-chip mar-chip-muted">
                                            Last given: @med.LastGiven
                                        </span>
                                    }
                                </div>
                            </div>
                        </article>
                    }
                }
            </section>

            <!-- PRN meds -->
            <section class="mar-column">
                <div class="mar-section-header">
                    <h2>PRN Medications</h2>
                    <p>Available as needed for this pet.</p>
                </div>

                @if (prnmeds == null || !prnmeds.Any())
                {
                    <p class="mar-empty">
                        No PRN medications available right now.
                    </p>
                }
                else
                {
                    @foreach (var med in prnmeds)
                    {
                        <article class="mar-med-card mar-med-card-prn">
                            <label class="mar-med-checkbox">
                                <input type="checkbox"
                                       class="mar-checkbox"
                                       @onchange="e => ToggleSelected(pet.Id, med.Id, hour, e)" />
                                <span class="mar-checkbox-custom"></span>
                            </label>

                            <div class="mar-med-content">
                                <h3 class="mar-med-name">
                                    @med.Name
                                    <span class="mar-chip mar-chip-prn">PRN</span>
                                </h3>
                                <p class="mar-med-details">
                                    @($"{med.DoseValue:0.##}") @med.DoseType &bull;
                                    @med.Route &bull;
                                    @med.Frequency
                                </p>

                                @if (med.LastGiven != null)
                                {
                                    <div class="mar-med-meta">
                                        <span class="mar-chip mar-chip-muted">
                                            Last given: @med.LastGiven
                                        </span>
                                    </div>
                                }
                            </div>
                        </article>
                    }
                }
            </section>
        </div>

        <div class="mar-actions">
            <button class="epic-pet-button epic-pet-button-outlined"
                    @onclick="OpenHoldModal"
                    disabled="@(_selectedMeds.Count == 0)">
                Hold Selected
            </button>

            <button class="epic-pet-button"
                    @onclick="MarkSelectedGiven"
                    disabled="@(_selectedMeds.Count == 0)">
                Give Selected
            </button>
        </div>

        @if (_showHoldModal)
        {
            <div class="modal-overlay">
                <div class="modal-container">
                    <h3>Hold Medications</h3>
                    <p>Provide a brief reason for holding the selected medications.</p>

                    <textarea class="hold-textarea"
                              @bind="_holdReason"
                              placeholder="Reason for hold (required)">
                            </textarea>

                    <div class="modal-buttons">
                        <button class="epic-pet-button"
                                @onclick="ConfirmHold"
                                disabled="@string.IsNullOrWhiteSpace(_holdReason)">
                            Submit Hold
                        </button>

                        <button class="epic-pet-button epic-pet-button-outlined"
                                @onclick="CloseHoldModal">
                            Cancel
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>

       <div class="mar-page-container">
        @if (_marHistory.FirstOrDefault() is null)
        {
            <div>No medication history yet</div>
        }
        else {

     
           @foreach (var history in _marHistory)
        {
            <div class="mar-med-content">
                <h3>History</h3>
          
                <p class="mar-med-details">
                   @allmeds.FirstOrDefault(x => x.Id == history.MedId)?.Name
                </p>
                @if (@history.Reason is not null)
                {
                     <div class="mar-med-meta">
                    <span class="mar-chip mar-chip-primary">
                       
                        Held at: @history.TimeRecorded - Reason: @history.Reason
                    </span>
                </div>
                }
                else {
                        
                      <div class="mar-med-meta">
                    <span class="mar-chip mar-chip-primary">
                        @history.TimeRecorded
                    </span>
                </div>
                }
              
            </div>
        }
           }
    </div>
}

@code {
    [Parameter] public int PetId { get; set; }
    [Parameter] public int hour { get; set; }

    private PetDto? pet;
    private List<MedicationDto> allmeds = new();
    private List<MedicationDto> meds = new();
    private List<MedicationDto> prnmeds = new();
    private bool isLoading = true;

    private bool _showHoldModal = false;
    private string _holdReason = string.Empty;

    private List<MARHistoryDto> _marHistory = new();
    private bool _isLoadingHistory = false;

    public record SelectedMed(int PetId, int MedId, int Hour);
    private List<SelectedMed> _selectedMeds = new();

    public bool IsPrn(Frequency freq)
        => freq.ToString().StartsWith("AsNeeded");

    private int GetScheduledHour(MedicationDto med)
    {
        if (med.StartTime is null)
            return 0;

        return med.StartTime.Value.Hour;
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadMarPageData();
    }

    private static int HourDistance(int a, int b)
    {
        int diff = Math.Abs(a - b);
        return Math.Min(diff, 24 - diff);
    }

    private async Task LoadMarPageData()
    {
        isLoading = true;

        try
        {
            pet = await Api.GetPetById(PetId);
            allmeds = await Api.GetMedsById(PetId);

            var today = DateOnly.FromDateTime(DateTime.Today);
            _marHistory = await Api.GetMarHistoryForDateAsync(today, PetId);

            var completedAtHour = _marHistory
                .Where(h =>
                    h.Hour == hour &&
                    (h.Action == MedicationAction.Given ||
                     h.Action == MedicationAction.Held))
                .Select(h => h.MedId)
                .ToHashSet();

            meds = allmeds
                .Where(m => !IsPrn(m.Frequency) &&
                            !completedAtHour.Contains(m.Id) &&
                            HourDistance(GetScheduledHour(m), hour) <= 1)
                .ToList();

            prnmeds = allmeds
                .Where(m => IsPrn(m.Frequency) &&
                            !completedAtHour.Contains(m.Id))
                .ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error fetching MAR data: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task ReloadPet()
    {
        try
        {
            pet = await Api.GetPetById(PetId);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error fetching pet: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    void ToggleSelected(int petId, int medId, int hour, ChangeEventArgs e)
    {
        bool selected = (bool)e.Value;

        if (selected)
        {
            _selectedMeds.Add(new(petId, medId, hour));
        }
        else
        {
            _selectedMeds.RemoveAll(x =>
                x.PetId == petId &&
                x.MedId == medId &&
                x.Hour == hour);
        }
    }

    async Task MarkSelectedGiven()
    {
        if (_selectedMeds.Count == 0) return;

        await Api.MarkGivenAsync(_selectedMeds);

        _selectedMeds.Clear();
        await LoadMarPageData();
        Nav.NavigateTo("/");
    }

    private async Task LoadGivenForPastYear()
    {
        _isLoadingHistory = true;

        try
        {
            _marHistory = await Api.GetMARHistoryAsync()
                          ?? new List<MARHistoryDto>();
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Error loading MAR history: {ex.Message}");
            _marHistory = new List<MARHistoryDto>();
        }

        _isLoadingHistory = false;
        StateHasChanged();
    }

    private void OpenHoldModal()
    {
        if (_selectedMeds.Count == 0)
            return;

        _holdReason = string.Empty;
        _showHoldModal = true;
    }

    private void CloseHoldModal()
    {
        _showHoldModal = false;
        _holdReason = string.Empty;
    }

    private async Task ConfirmHold()
    {
        if (_selectedMeds.Count == 0)
            return;

        await Api.MarkHeldAsync(_selectedMeds, _holdReason);

        _selectedMeds.Clear();
        CloseHoldModal();

        await LoadGivenForPastYear();
        Nav.NavigateTo("/");
    }
}
