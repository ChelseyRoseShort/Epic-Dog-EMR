@page "/petprofile/{id:int}"
@using EpicPetEMR_Ui.Services
@using EpicPetEMR.Shared.Models
@using Microsoft.AspNetCore.Components.Forms
@using EpicPetEMR_Ui.Modals
@inject PetApi Api
<h3>Pet Profile</h3>
@if (isLoading)
{
    <p>Loading pet data...</p>
}
else if (pet == null)
{
    <p>Pet not found.</p>
    <button @onclick="ReloadPet" class="btn btn-success">Reload1Pet</button>
}
else 
{
     @* Viewable html goes here when pet is not null *@
    <div class="pet-profile">
<AddMedication 
    IsOpen="AddMed"
    Title="Add Medication"
    OnClose="() => AddMed = false"
    OnConfirm="SaveMedication">

            <div class="med-row">

                <h4>Medication</h4>

                <div class="form-row">
                    <label>Name</label>
                    <input class="form-control" @bind="newMedication.Name" />
                </div>

                <div class="form-row">
                    <label>Dose Value</label>
                    <input type="number" class="form-control" @bind="newMedication.DoseValue" />
                </div>

                <div class="form-row">
                    <label>Dose Type</label>
                    <InputSelect TValue="Dosages" class="form-control" @bind-Value="newMedication.DoseType">
                        @foreach (var value in Enum.GetValues<Dosages>())
                        {
                            <option value="@value">@value</option>
                        }
                    </InputSelect>
                </div>

                <div class="form-row">
                    <label>Route</label>
                    <InputSelect TValue="Routes" class="form-control" @bind-Value="newMedication.Route">
                        @foreach (var value in Enum.GetValues<Routes>())
                        {
                            <option value="@value">@value</option>
                        }
    )
                    </InputSelect>
                </div>

                <div class="form-row">
                    <label>Frequency</label>
                    <InputSelect TValue="Frequency" class="form-control" @bind-Value="newMedication.Frequency">
                        
                    @foreach (var value in Enum.GetValues<Frequency>())
                        {
                            <option value="@value">@value</option>
                        }
                        
                    </InputSelect>
                </div>

                <div class="form-row">
                    <label>Instructions</label>
                    <textarea class="form-control" @bind="newMedication.Instructions"></textarea>
                </div>

                <div class="form-row">
                    <label>Start Date</label>
                    <input type="date"
                           class="form-control"
                           @bind="newMedication.StartDate"
                           @bind:format="yyyy-MM-dd" />
                </div>

                <div class="form-row">
                    <label>End Date</label>
                    <input type="date"
                           class="form-control"
                           @bind="newMedication.EndDate"
                           @bind:format="yyyy-MM-dd" />
                </div>

                <div class="form-row checkbox-row">
                    <label>Active?</label>
                    <input type="checkbox" class="form-check-input" @bind="newMedication.IsActive" />
                </div>

            </div>



</AddMedication>




        <h4>@pet.Name (@pet.Species)</h4>
        <p><strong>Breed:</strong> @pet.Breed</p>
        <p><strong>Age:</strong> @CalculatePetAge(pet.DateOfBirth)</p>
        <button @onclick="AddMedication" style="lighting-color">Add Medication</button>


        <InputFile OnChange="UploadPhoto" accept="image/*"  />  
        @if (!string.IsNullOrEmpty(pet.ProfilePic))
        {
            <img src="@($"https://localhost:60174{pet.ProfilePic}")"
                 style="max-width:300px;" />

        }
        else
        {
            <img src="https://external-preview.redd.it/4aDXjLN7Wgk59hNtHaN-hL8Nsz3CbH2r2EVFUVG4nBo.jpg?auto=webp&s=3e835496d5ef78fdb74ddef15749a665ee5de1e5"
                 alt="Sample Dalmatian with heterochromia"
                 style="max-width:300px; border-radius:10px;" />
        }
@*  <InputFile OnChange="UploadPhoto" accept="image/*"  />  *@
    </div>
}
    <div class="current-medication-container">
    <h2>Current Medications</h2>
    @foreach (var med in meds)
    {
        <h3>@med.Name</h3>
        <div>@med.DoseValue @med.DoseType</div>
        <div> <strong>Route</strong> @med.Route</div>
        <div> <strong>Frequency</strong> @med.Frequency</div>
        <div>@med.Instructions</div> <button @onclick="()=>MedConfirmDelete(med)" class="alert-danger">Delete Medication</button>
    }
    @if (deleteconfirm)
    {
        <div class="modal-overlay">
            <div class="modal-box">
                <h4>Delete @MedToDelete.Name?</h4>
                <p>Are you sure you want to delete this medication?</p>

                <div class="modal-buttons">
                    <button class="btn btn-danger" @onclick="async () => await DeleteMed(MedToDelete!)">Delete</button>
                    <button class="btn btn-secondary" @onclick="() => deleteconfirm = false">Cancel</button>
                </div>
            </div>
        </div>
    }
</div >
@code {
    [Parameter]
    public int id { get; set; }
    private PetDto? pet;
    private bool AddMed = false;
    private bool isLoading = true;
    private MedicationDto newMedication = new();
    private List<MedicationDto> meds = new();
    private bool deleteconfirm = false;
    private MedicationDto MedToDelete = new();




    private async Task SaveMedication()
    {
        newMedication.PetId = pet.Id;
        // you will write saving logic later
        await Api.AddMedAsync(newMedication);
        await ReloadMedsAsync();
        AddMed = false;
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            pet = await Api.GetPetById(id);
            meds = await Api.GetMedsById(id);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error fetching pet data: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }

    }

    // add UploadPhoto method here 
    private async Task UploadPhoto(InputFileChangeEventArgs e)
    {
        var file = e.File;
        var UpdatedPet = await Api.UploadPetPhoto(pet.Id, file);

        if (UpdatedPet != null)
        {
            pet = UpdatedPet;
            StateHasChanged();
            ReloadPet();
        }

    

    }
    private void AddMedication()
    {
        AddMed = true;

    }


    private string CalculatePetAge(DateOnly? dob)
    {
        if (dob is null) return "Unknown";

        var today = DateOnly.FromDateTime(DateTime.Today);

        int years = today.Year - dob.Value.Year;
        int months = today.Month - dob.Value.Month;

        if (today.Day < dob.Value.Day)
            months--;

        if (months < 0)
        {
            years--;
            months += 12;
        }

        if (years <= 0 && months <= 0)
            return "Less than a month";

        if (years <= 0)
            return $"{months} months";

        if (months == 0)
            return $"{years} years";

        return $"{years} years {months} months";
    }

    private void MedConfirmDelete(MedicationDto Medication)
    {

         MedToDelete = Medication;
         deleteconfirm = true;
    }

    private async Task DeleteMed(MedicationDto Medication)
    {

        deleteconfirm = false;

        await Api.DeleteMed(Medication);

        StateHasChanged();
        

        await ReloadMedsAsync();
    }

    private async Task LoadMedsAsync()
    {
        try
        {
            
            meds = await Api.GetMedsById(id);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error fetching pet data: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task ReloadMedsAsync()
    {
        await LoadMedsAsync();
    }

    private async Task ReloadPet()
    {
        try
        {
            pet = await Api.GetPetById(id);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error fetching pet data: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }
}
