@page "/"
@using EpicPetEMR_Ui.Services
@using EpicPetEMR.Shared.Models
@using EpicPetEMR_Ui.ViewModels
@using static EpicPetEMR_Ui.Services.MedicationScheduleService
@using EpicPetEMR_Ui.Modals
@implements IDisposable
@inject PetApi Api
@inject MedicationScheduleService Scheduler
@inject NavigationManager Nav
@inject FamilyApi FamilyApi


<div class="shift-row">

    <label class="shift-label">Shift:</label>

    <label class="shift-toggle">
        <input type="checkbox" checked="@(_shift == "night")" @onchange="OnShiftToggle" />
        <span class="shift-toggle-track">
            <span class="shift-toggle-thumb"></span>
        </span>
    </label>

    <span class="shift-toggle-text">@(_shift == "night" ? "Night (20:00–06:00)" : "Day (07:00–19:00)")</span>
</div>
 <AddVetTrip IsOpen="isAddDocumentOpen"
                       Title="Upload Veterinary Trip Document"
                        OnConfirm="SaveVetDocument"
                       OnClose="() => isAddDocumentOpen = false">
                       <InputFile OnChange="HandleFileSelected"
                        multiple
                       
                        accept="image/*,.pdf,.doc,.docx,.xls,.xlsx,.txt" 
                        />
                    

            <div class="form-grid">
                <div class="form-group full-width">
                    <label>Hospital</label>
                    <input class="form-input"  placeholder="e.g. Healing Paws Veterinary Center " />
                </div>

            </div>
            
        </AddVetTrip>
<!-- Mobile card layout (hidden on desktop via CSS) -->
<div class="mobile-board">
    @foreach (var p in _pets)
    {
        var hasAnything = Tasks.TryGetValue(p.Pet.Id, out var petHours) && petHours.Count > 0;
        var hasVetTrips = VetTripsByPetAndHour.TryGetValue(p.Pet.Id, out var vetHours) && vetHours.Count > 0;

        if (!hasAnything && !hasVetTrips) continue;

        <div class="mobile-pet-card">
            <div class="mobile-pet-header">
                <a href="petprofile/@p.Pet.Id" class="mobile-pet-name">@p.Pet.Name</a>
                <span class="mobile-pet-meta">@p.Pet.Breed &bull; @p.Pet.Sex</span>
            </div>

            <div class="mobile-task-list">
                @foreach (var h in Hours)
                {
                    var hasMeds = petHours != null && petHours.TryGetValue(h, out var meds) && meds.Count > 0;
                    var hasVet = vetHours != null && vetHours.TryGetValue(h, out var trips) && trips.Count > 0;

                    if (!hasMeds && !hasVet) continue;

                    <div class="mobile-hour-row">
                        <span class="mobile-hour-label">@($"{h:00}:00")</span>
                        <div class="mobile-hour-tasks">
                            @if (hasMeds)
                            {
                                var meds2 = petHours![h];
                                var due = meds2.Where(m => !m.IsCompleted).ToList();
                                var allDone = due.Count == 0;

                                <button style="margin-top:3px !important;"  class="mobile-task-pill @(allDone ? "pill-done" : "pill-med")"
                                        @onclick="() => GoToMAR(p.Pet.Id, h)">
                                    @if (allDone)
                                    {
                                        <i class="fa-regular fa-circle-check"></i>
                                        <span></span>
                                    }
                                    else
                                    {
                                        <i class="fa-solid fa-prescription-bottle" style="color:#193020 !important;"></i>
                                        <span>@string.Join(", ", due.Select(m => m.Name))</span>
                                    }
                                </button>
                            }
                            @if (hasVet)
                            {
                                List<VetTripDto>? trips2 = vetHours![h];
                                @foreach (VetTripDto trip in trips2)
                                {
                                 @if (!trip.Documents.Any())
                                 {
                                        <button class="mobile-task-pill pill-vet"
                                            @onclick="() => GoToVetTrip(p.Pet.Id, h, trip.Id)">
                                        <i class="fa-solid fa-hospital"></i>
                                        <span>@(string.IsNullOrEmpty(trip.Hospital) ? "Vet trip" : trip.Hospital)</span>
                                    </button>
                                 }
                                 else {
                                    /* need a "comeplted vet trip" here */
                                     <button class="mobile-task-pill pill-done" style="margin-top:3px !important;"
                                       >
                                        <i class="fa-regular fa-circle-check"></i>
                                        <span>All done (@(string.IsNullOrEmpty(trip.Hospital) ? "Vet trip" : trip.Hospital))</span>
                                        </button>
                                 }

                                                                  
                                }
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>

<!-- Desktop grid (hidden on mobile via CSS) -->
<div class="board @(_shift == "night" ? "night-mode" : "")">

    <div class="grid" style="grid-template-columns:@GridTemplateColumns">

        @if (CurrentTimeBarStyle is not null)
        {
            <div class="current-time-bar" style="@CurrentTimeBarStyle"></div>
        }

        <div class="cell header sticky-left corner">Patient</div>

        @foreach (var h in Hours)
        {
            <div class="cell header">@($"{h:00}:00")</div>
        }

        @for (int idx = 0; idx < _pets.Count; idx++)
        {
            var p = _pets[idx];
            var rowClass = (idx % 2 == 0) ? "row-even" : "row-odd";

            <div class="cell sticky-left @rowClass">
                <a class="hover-parent" href="petprofile/@p.Pet.Id">@p.Pet.Name</a>
                <div class="hidden-initially">

                    <ul>

                        <li>
                            @p.Pet.Breed
                        </li>
                        
                        <li>
                            @p.Pet.Sex
                        </li>
                    </ul>

                </div>
                    <style> .hidden-initially { opacity:0;}
                    .hover-parent:hover + .hidden-initially { opacity:1;}
                    </style>
            </div>

            @foreach (var h in Hours)
            {
                List<MedScheduleItem> meds = null;

                var hasMeds = Tasks.TryGetValue(p.Pet.Id, out var perHour) &&
                perHour.TryGetValue(h, out meds);

                meds ??= new List<MedScheduleItem>();
                
              
                var dueMeds = meds.Where(m => !m.IsCompleted).ToList();
                bool anyScheduled = meds.Count > 0;
                bool allCompleted = anyScheduled && dueMeds.Count == 0;
                var done = allCompleted;

                List<VetTripDto> vetTrips = null;
                var hasVetTrips = VetTripsByPetAndHour.TryGetValue(p.Pet.Id, out var vetPerHour)
                && vetPerHour.TryGetValue(h, out vetTrips);

                vetTrips ??= new List<VetTripDto>();
                bool anyVetTrips = vetTrips.Count > 0;


                <div class="cell task-cell @rowClass @(done ? "done" : null)"
                     data-patient-id="@p.Pet.Id"
                     data-hour="@h">

                    @if (hasMeds)
                    {
                        @if (allCompleted)
                        {
                            <div class="task-wrap">
                                <i class="fa-regular fa-circle-check fa-2xl" style="color: #4195b9;"></i>

                                <button class="button-plain overlay-button"
                                        @onclick="() => GoToMAR(p.Pet.Id, h)">
                                </button>
                            </div>
                        }
                        else
                        {
                            <div class="task-wrap">
                                <i class="fa-solid fa-prescription-bottle fa-2xl task-icon" style="color:#0e2817 !important;"></i>
                                <div class="task-badge">
                                    <button class="button-plain" @onclick="() => GoToMAR(p.Pet.Id, h)">
                                        @foreach (var med in dueMeds)
                                        {
                                            <div class="med-in-badge">
                                                @med.Name
                                            </div>
                                        }
                                    </button>
                                </div>
                            </div>
                        }
                    }

                    @if (anyVetTrips)
                    {
                        <div class="task-wrap vettrip-wrap">
                            <button class="button-plain vettrip-button"
                                    @onclick="() => GoToVetTrip(p.Pet.Id, h, vetTrips.FirstOrDefault()?.Id ?? 0)">
                                <i class="fa-solid fa-hospital fa-xl vettrip-icon" style="color:#0e2817"></i>

                                @foreach (var trip in vetTrips)
                                {
                                    <div class="vettrip-pill">
                                        <div class="task-badge">
                                           <span class="vettrip-hospital">@trip.Hospital</span>
                                        <span class="vettrip-visitdatetime">@trip.VisitDateTime</span>
                                        <span class="vettrip-reason">@trip.Reason</span>
                                        </div>

                                     
                                    </div>
                                }
                            </button>
                        </div>
                    }
                </div>
            }

        }
    </div>
</div>

<style>
  /* ── Mobile card board ── */
  .mobile-board {
      display: none; /* hidden by default; shown on small screens */
      flex-direction: column;
      gap: 12px;
      padding: 8px 0;
  }

  .mobile-pet-card {
      background: #fff;
      border: 1px solid #e3e3e3;
      border-radius: 12px;
      overflow: hidden;
      box-shadow: 0 1px 4px rgba(0,0,0,0.07);
  }

  .mobile-pet-header {
      display: flex;
      align-items: baseline;
      gap: 8px;
      padding: 10px 14px;
      background: #fafafa;
      border-bottom: 1px solid #e3e3e3;
  }

  .mobile-pet-name {
      font-weight: 700;
      font-size: 1rem;
      color: var(--pet-primary);
      text-decoration: none;
  }

  .mobile-pet-name:hover { text-decoration: underline; }

  .mobile-pet-meta {
      font-size: 0.78rem;
      color: #888;
  }

  .mobile-task-list {
      display: flex;
      flex-direction: column;
  }

  .mobile-hour-row {
      display: flex;
      align-items: flex-start;
      gap: 10px;
      padding: 8px 14px;
      border-bottom: 1px solid #f0f0f0;
  }

  .mobile-hour-row:last-child { border-bottom: none; }

  .mobile-hour-label {
      font-size: 0.78rem;
      font-weight: 600;
      color: #888;
      min-width: 44px;
      padding-top: 4px;
  }

  .mobile-hour-tasks {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
      flex: 1;
  }

  .mobile-task-pill {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 5px 10px;
      border-radius: 20px;
      border: none;
      font-size: 0.82rem;
      font-weight: 600;
      cursor: pointer;
      transition: opacity 0.15s;
  }

  .mobile-task-pill:active { opacity: 0.75; }

  .pill-med {
      background: linear-gradient(135deg, #385223, #ecd46a);
      color: #fff;
  }

  .pill-done {
      background: #e8f5e9;
      color: #2e7d32;
  }

  .pill-vet {
    background: linear-gradient(135deg, #385223, #ecd46a);
    color: #fff;
  }

  @@media (max-width: 640px) {
      .mobile-board { display: flex; }
      .board        { display: none; }
  }

  .task-cell {
    position: relative;
    overflow: visible !important;  /* overrides .cell's overflow: hidden */
    z-index: 1;
}

.task-cell:hover {
    z-index: 100 !important;  /* needs to beat any stacking context from .grid or .board */
}

    .task-wrap {
        position: relative;
        width: 100%;
        height: 100%;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .task-icon {
        color: #483a73;
        transition: opacity 0.3s ease-in-out;
    }

    .task-badge {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%) scale(0.85);
        z-index: 11;
        opacity: 0;
        padding: 6px 12px;
        border-radius: 20px;
        background: linear-gradient(135deg, #193020, #345e40);
        color: white;
        font-weight: 600;
        font-size: 0.9rem;
        text-align: center;
        box-shadow: 0 0 12px rgba(52, 107, 80, 0.7);
        transition: opacity 0.3s ease, transform 0.25s ease;
        white-space: nowrap;
  
    }

    .task-cell:hover .task-badge {
        opacity: 1;
        transform: translate(-50%, -50%) scale(1);
    }

    .task-cell:hover .task-icon {
        opacity: 0;
    }

    .task-cell.done {
    }

    .completed-icon {
        color: #2e7d32;
    }

    .overlay-button {
        position: absolute;
        inset: 0;
        border: none;
        background: transparent;
        cursor: pointer;
    }
</style>

@code {
    private string _shift = "day";

    [Parameter] public int StartHour { get; set; } = 7;
    [Parameter] public int EndHour { get; set; } = 19;



    private int? _selectedPetId;
    private int? _selectedVetTripId;
  
    private List<IBrowserFile> _pendingFiles = new();
    private bool _loading = true;
    private string? _error;
    private List<PetWithMedsVm> _pets = new();
   private bool isAddDocumentOpen = false;
    private Dictionary<int, Dictionary<int, List<MedScheduleItem>>> Tasks = new();
    private Dictionary<int, Dictionary<int, List<VetTripDto>>> VetTripsByPetAndHour
    = new();
    private List<MARHistoryDto> _marHistory = new();

    private List<int> Hours
    {
        get
        {
            if (StartHour <= EndHour)
                return Enumerable.Range(StartHour, EndHour - StartHour + 1).ToList();

            var late = Enumerable.Range(StartHour, 24 - StartHour);
            var early = Enumerable.Range(0, EndHour + 1);
            return late.Concat(early).ToList();
        }
    }

    private string GridTemplateColumns =>
        $"var(--left-col) repeat({Hours.Count}, var(--cell))";

    private System.Threading.Timer? _clockTimer;

    private static bool IsUtcNightHour(int utcHour) => utcHour >= 20 || utcHour < 7;

    private string? CurrentTimeBarStyle
    {
        get
        {
            var now = DateTime.Now;
            var idx = Hours.IndexOf(now.Hour);
            if (idx < 0)
                return null;

            var offset = idx + (now.Minute / 60.0);
            var offsetStr = offset.ToString(System.Globalization.CultureInfo.InvariantCulture);
            return $"left: calc(var(--left-col) + {offsetStr} * var(--cell));";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        if (IsUtcNightHour(DateTime.UtcNow.Hour))
        {
            _shift = "night";
            StartHour = 20;
            EndHour = 6;
        }
        else
        {
            _shift = "day";
            StartHour = 7;
            EndHour = 19;
        }

        await Load();

        _clockTimer = new System.Threading.Timer(_ =>
        {
            InvokeAsync(StateHasChanged);
        }, null, TimeSpan.FromSeconds(30), TimeSpan.FromSeconds(30));
    }

    public void Dispose()
    {
        _clockTimer?.Dispose();
    }

    private async Task Load()
    {
        _loading = true;
        _error = null;

        try
        {
            var families = await FamilyApi.GetMyFamiliesAsync();
           _pets = await Api.GetPetsAsync(includeMeds: true);
            var today = DateOnly.FromDateTime(DateTime.Now);
            _marHistory = await Api.GetMarHistoryForDateAsync(today);
            var vetTrips = await Api.GetVetTripsTodayAsync();
            VetTripsByPetAndHour = vetTrips
       .GroupBy(v => v.PetId)
       .ToDictionary(
           g => g.Key,
           g => g.GroupBy(v => v.VisitDateTime.Hour)
                 .ToDictionary(
                     hh => hh.Key,
                     hh => hh.ToList()
                 )
       );

            Tasks = Scheduler.BuildBrainSchedule(_pets, StartHour, EndHour, _marHistory);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OnShiftToggle(ChangeEventArgs e)
    {
        var isNight = e.Value is bool b && b;
        _shift = isNight ? "night" : "day";

        if (isNight)
        {
            StartHour = 20;
            EndHour = 6;
        }
        else
        {
            StartHour = 7;
            EndHour = 19;
        }

        await Load();
        StateHasChanged();
    }

    public record PatientRow(int Id, string Name);

    void GoToMAR(int petId, int hour)
    {
        Nav.NavigateTo($"/mar/task/{petId}/{hour}");
    }
    void GoToVetTrip(int petId, int hour, int tripId)
    {
        Console.WriteLine($"Navigating to vet trip for pet {petId} at hour {hour}, trip id {tripId}");
        _selectedPetId = petId;
        _selectedVetTripId = tripId;

     
        isAddDocumentOpen = true;
    }

    private async Task SaveVetDocument()
    {
        

        foreach (var file in _pendingFiles)
        {
            var displayName = file.Name;
            var docType = DocumentType.VetTrip;

            await Api.UploadPetDocumentAsync(
                petId: _selectedPetId.Value,
                vetTripId: _selectedVetTripId.Value,
                file: file,
                name: displayName,
                type: docType
                
            );
        }

        _pendingFiles.Clear();
        isAddDocumentOpen = false;
        await Load();


      
      
    }

    void HandleFileSelected(InputFileChangeEventArgs e)
    {
        foreach (var file in e.GetMultipleFiles())
        {
            Console.WriteLine($"Selected file: {file.Name}, size: {file.Size} bytes");


        }

        _pendingFiles = e.GetMultipleFiles().ToList();

    }
}
