@page "/login"
@using EpicPetEMR.Shared.Models.Auth
@layout EmptyLayout
@inject EpicPetEMR_Ui.Services.AuthApi Auth
@inject EpicPetEMR_Ui.Services.TokenStore Tokens
@inject NavigationManager Nav

<div class="login-card">
    <div class="login-logo">
        <i class="fa-solid fa-paw login-paw-icon"></i>
        <div class="login-app-name">PetChance EMR</div>
    </div>

    <div class="login-form">
        <h3 class="login-subtitle">Sign In</h3>
        <input class="login-input" placeholder="Email" type="email" @bind="Model.Email" />
        <input class="login-input" placeholder="Password" type="password" @bind="Model.Password" />
        <button class="login-btn-primary" @onclick="DoLogin">Login</button>
        <button class="login-btn-primary" @onclick="DoDemo">Demo</button>

        @if (!string.IsNullOrWhiteSpace(Message))
        {
            <p class="login-error">@Message</p>
        }

        <div class="login-register">
            <span>Don't have an account?</span>
            <button class="login-btn-secondary" @onclick='() => Nav.NavigateTo("/register")'>Register</button>
        </div>
    </div>
</div>

@code {
    private LoginRequest Model = new();
    private string? Message;

    private async Task DoLogin()
    {
        Message = null;
        try
        {
            var res = await Auth.LoginAsync(Model);
            await Tokens.SetAsync(res.Token);
            await Tokens.SetEmailAsync(Model.Email);
            Nav.NavigateTo("/");
        }
        catch (Exception ex)
        {
            Message = ex.Message;
        }
    }

    private async Task DoDemo()
    {
        Model.Email = "demo@demo.com";
        Model.Password = "ThisIsADemo123*";
        await DoLogin();
    }
}
