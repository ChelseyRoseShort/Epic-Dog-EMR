<div class="ps-3 navbar navbar-dark emr-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">PetChance EMR</a>
        <button title="Navigation menu" class="navbar-toggler" @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
    </div>
</div> 

<div class="@NavMenuCssClass nav-scrollable" @onclick="ToggleNavMenu">
    <nav class="flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <i style="margin-right:10px;" class="fa-solid fa-brain fa-2xl"></i>Brain
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="pets">
                <i style="margin-right:10px;"  class="fa-solid fa-paw fa-2xl"></i> My Pets
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="login">
               <i style="margin-right:10px;"  class="fa-solid fa-circle-user fa-2xl"></i>Login
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="families">
               <i style="margin-right:10px;"  class="fa-solid fa-people-roof fa-2xl"></i>Family
            </NavLink>
        </div>

        <div class="mobile-signed-in">
            <p class="signed-in-button">Signed in as: @SignedInLabel</p>
            <button @onclick="OnSignOut" class="mobile-sign-out-btn">
                Sign out
            </button>
        </div>
    </nav>
</div>

@code {
    private bool collapseNavMenu = true;

    [Parameter] public string SignedInLabel { get; set; } = "(not signed in)";
    [Parameter] public EventCallback OnSignOut { get; set; }

    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }
}
