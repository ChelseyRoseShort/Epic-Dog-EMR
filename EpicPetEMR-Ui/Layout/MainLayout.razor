@inherits LayoutComponentBase
@using EpicPetEMR_Ui.Services
@inject TokenStore Tokens
@inject NavigationManager Nav
@using System.IdentityModel.Tokens.Jwt
<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            <div style="display:flex; align-items:center">
            <p style="
            border: 2px solid white;
            background-color: mediumslateblue;
            color: white;
            padding: 3px 6px;
            border-radius: 6px;
            font-weight: bold;
            font-size: 14px;
            margin-left: 8px;
            margin-bottom: 0px;
            ">Signed in as: @_label</p>
            <button @onclick="HandleSignOut" style="
                background-color: mediumslateblue;
                color: white;
                border: 2px solid white;
                padding: 3px 6px;
                border-radius: 6px;
                font-weight: bold;
                cursor: pointer;
                font-size: 14px;   
                margin-left: 8px;">
                Sign out
            </button>
        </div>
        </div>
        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

@code {
    private string _label = "(not signed in)";

    private async Task HandleSignOut()
    {
        await Tokens.ClearAsync();
        Nav.NavigateTo("/login");
    }

    protected override async Task OnInitializedAsync()
    {
        var token = await Tokens.GetTokenAsync();
        if (string.IsNullOrWhiteSpace(token)) return;

        var jwt = new JwtSecurityTokenHandler().ReadJwtToken(token);

        var email = jwt.Claims.FirstOrDefault(c => c.Type == "email")?.Value
                    ?? jwt.Claims.FirstOrDefault(c => c.Type.EndsWith("/emailaddress"))?.Value;

        var display = jwt.Claims.FirstOrDefault(c => c.Type == "display_name")?.Value;

        _label = !string.IsNullOrWhiteSpace(display) ? display :
                 !string.IsNullOrWhiteSpace(email) ? email :
                 "(signed in)";
    }
}
